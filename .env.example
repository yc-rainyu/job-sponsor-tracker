# PostgreSQL (used by compose.yaml to initialise the db container)
POSTGRES_USER=jst
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jst

# API
DATABASE_URL=postgresql+psycopg://jst:change-me@localhost:5432/jst
APP_ENV=dev
JWT_SECRET=
# Google OAuth Web client ID (same value as web NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Same value as web PROXY_KEY. With it set, the api trusts the visitor IP that
# web/proxy.ts forwards, so rate limits count per visitor behind Vercel.
# Empty disables that. Generate with: openssl rand -hex 32
PROXY_KEY=

# Web (where web/proxy.ts forwards /api/* to)
API_URL=http://localhost:8000

# Caddy (deploy/compose.prod.yaml). Local: ":80". Production: "tracker-api.<domain>"
SITE_ADDRESS=:80

# EC2 only. Full S3 bucket name (account regional suffix included). Not used on Mac.
BACKUP_BUCKET=