# PostgreSQL (used by compose.yaml to initialise the db container)
POSTGRES_USER=jst
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jst

# API
DATABASE_URL=postgresql+psycopg://jst:change-me@localhost:5432/jst
APP_ENV=dev
JWT_SECRET=

# Web (Next.js rewrite target; used by web/next.config.ts)
API_URL=http://localhost:8000

# Caddy (deploy/compose.prod.yaml). Local: ":80". Production: "tracker-api.<domain>"
SITE_ADDRESS=:80
