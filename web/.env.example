# Copy to .env.local and fill in. .env.local is gitignored.

# Same Google OAuth Web client ID as root .env GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Same value as root .env PROXY_KEY. Server-only, so no NEXT_PUBLIC_ prefix.
# proxy.ts sends it with the visitor IP so the api can rate limit per visitor.
PROXY_KEY=
